# Optional: the app works fully offline/local-first without these.
# Both values are public by design (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SUPABASE_SERVICE_ROLE_KEY must NEVER be placed in this file, the client or CI for the web app.
# It exists only inside the Edge Function runtime (injected by Supabase);
# set ALLOWED_ORIGIN with `supabase secrets set ALLOWED_ORIGIN=https://your-site.pages.dev`.
